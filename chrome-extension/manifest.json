{
  "manifest_version": 3,
  "name": "AI客服助手 - 多平台自动回复",
  "version": "1.0.0",
  "description": "虾皮/亚马逊等电商平台买家消息自动AI回复",
  "permissions": ["storage"],
  "host_permissions": [
    "*://seller.shopee.tw/*",
    "*://seller.shopee.cn/*",
    "*://seller.shopee.sg/*",
    "*://seller.shopee.my/*",
    "*://seller.shopee.vn/*",
    "*://seller.shopee.ph/*",
    "*://seller.shopee.co.id/*",
    "*://seller.shopee.co.th/*",
    "*://seller.shopee.com.br/*",
    "*://seller.shopee.com.mx/*",
    "*://sellercentral.amazon.com/*",
    "*://sellercentral.amazon.co.jp/*",
    "*://sellercentral.amazon.co.uk/*",
    "*://sellercentral-europe.amazon.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://seller.shopee.tw/*",
        "*://seller.shopee.cn/*",
        "*://seller.shopee.sg/*",
        "*://seller.shopee.my/*",
        "*://seller.shopee.vn/*",
        "*://seller.shopee.ph/*",
        "*://seller.shopee.co.id/*",
        "*://seller.shopee.co.th/*",
        "*://seller.shopee.com.br/*",
        "*://seller.shopee.com.mx/*",
        "*://sellercentral.amazon.com/*",
        "*://sellercentral.amazon.co.jp/*",
        "*://sellercentral.amazon.co.uk/*",
        "*://sellercentral-europe.amazon.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}